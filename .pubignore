# A .pubignore replaces the .gitignore of the same directory when publishing,
# so the rules of the root .gitignore are repeated below. Keep them in sync.

# Not part of the published package
/CLAUDE.md

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Flutter/Dart/Pub related
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/

config/

# Pana reports
.pana_reports/
